name: 25.12-test

on:
  repository_dispatch:
  workflow_dispatch:

env:
  LOG_PATH:         N1/Immortalwrt/25.12/logs.txt
  TZ:               Asia/Shanghai
  VERSION_TAG:      '25.12'
  UPLOAD_RELEASE:   'true'
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: 'true'

jobs:
  build:
    runs-on: ubuntu-24.04
    permissions:
      actions: write
      contents: write

    steps:

    - name: 检出仓库
      uses: actions/checkout@v4

    # 跳过编译，直接下载之前成功的 rootfs 模拟编译产物
    - name: 模拟编译产物（下载已有 rootfs）
      id: compile
      run: |
        mkdir -p openwrt-armvirt /workdir/upload
        wget -q --show-progress -O openwrt-armvirt/openwrt-armsr-armv8-generic-rootfs.tar.gz \
          https://github.com/ham-0915/N1-0407/releases/download/N1-25.12_20260601/openwrt-armsr-armv8-generic-rootfs.tar.gz
        echo "=== openwrt-armvirt 目录内容 ==="
        ls -lh openwrt-armvirt/
        echo "status=success" >> "$GITHUB_OUTPUT"

    - name: 打包 N1 固件
      if: steps.compile.outputs.status == 'success'
      uses: unifreq/openwrt_packit@master
      env:
        WHOAMI:              ham
        OPENWRT_ARMVIRT:     openwrt-armvirt/*.tar.gz
        PACKAGE_SOC:         s905d
        KERNEL_AUTO_LATEST:  true
        KERNEL_REPO_URL:     ophub/kernel
        KERNEL_VERSION_NAME: 6.12.y

    - name: 整理发布信息
      id: release_info
      if: steps.compile.outputs.status == 'success'
      run: |
        mkdir -p /workdir/upload
        [ -d /opt/openwrt_packit/output ] \
          && mv /opt/openwrt_packit/output/* /workdir/upload/
        echo "release_tag=N1-25.12-test_$(date +%Y%m%d%H%M)" >> "$GITHUB_OUTPUT"
        echo "release_date=$(date '+%Y-%m-%d %H:%M')"         >> "$GITHUB_OUTPUT"

    - name: 上传 Release
      if: steps.compile.outputs.status == 'success'
      uses: ncipollo/release-action@v1
      with:
        name:         "OpenWrt-N1 TEST ${{ steps.release_info.outputs.release_date }}"
        tag:          "${{ steps.release_info.outputs.release_tag }}"
        artifacts:    /workdir/upload/openwrt*
        allowUpdates: true
        token:        ${{ secrets.GITHUB_TOKEN }}
